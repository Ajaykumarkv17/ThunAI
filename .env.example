# =============================================================================
# ThunAI environment template  (Req 19.6, 18.4)
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in the blanks. `.env` is gitignored and must NEVER be
# committed. Every value below is empty or a synthetic placeholder — there are
# no real credentials or resource identifiers in this file.
#
# The ONLY flag that selects a synthetic backend is SYNTHETIC_SENSORS (Req 19.5).
# It defaults to 1 so a clean clone runs the seeded rising-river sweep by
# replaying the committed hazard-reading fixtures, while State_Store, the
# Knowledge Base, SNS/SES, AppSync, and Cognito remain live.
# =============================================================================

# -----------------------------------------------------------------------------
# AWS region  (agents/config.py, all boto3 clients)
# -----------------------------------------------------------------------------
AWS_REGION=us-west-2

# -----------------------------------------------------------------------------
# Model routing  (agents/config.py — the ONE module holding model ids, Req 19.9,
# 20.6). Exactly two ids, read from the environment, never hardcoded per agent.
# Use the Amazon Nova family: a Nova Lite-class id for low-cost extraction/
# classification, a Nova Pro-class id for trade-off reasoning/orchestration.
# ONLY Amazon Nova models are permitted (Claude/Anthropic ids are not allowed).
# validate_config() aborts the run at cold start naming any absent id.
# -----------------------------------------------------------------------------
THUNAI_LOW_COST_MODEL_ID=us.amazon.nova-lite-v1:0
THUNAI_HIGH_CAPABILITY_MODEL_ID=us.amazon.nova-pro-v1:0

# -----------------------------------------------------------------------------
# Sensor integration seam  (integrations/sensor_provider.py, Req 19.5)
#   SYNTHETIC_SENSORS=1  -> SyntheticSensorProvider replays SENSOR_FIXTURE_PATH.
#   SYNTHETIC_SENSORS=0  -> LiveSensorProvider via the AgentCore Gateway target
#                           named by SENSOR_GATEWAY_TARGET.
# -----------------------------------------------------------------------------
SYNTHETIC_SENSORS=1
SENSOR_FIXTURE_PATH=seed/hazard_readings
# Gateway target for the live (non-fixture) sensor feed; only read when
# SYNTHETIC_SENSORS=0. Tools exposed via a Gateway target are named
# ${target_name}___${tool_name} (three underscores).
SENSOR_GATEWAY_TARGET=

# -----------------------------------------------------------------------------
# Escalation-policy threshold overrides  (policy/escalation_policy.py, Req 10.8)
# The escalation policy is the single source of every autonomy threshold. These
# env overrides let a deployment tune the policy without code changes; leave
# blank to use the in-code defaults. validate_policy() rejects out-of-range
# values at cold start. Values shown are the design defaults, commented out.
# -----------------------------------------------------------------------------
# THUNAI_CONFIDENCE_FLOOR=0.70
# THUNAI_MASS_NOTIFICATION_AUDIENCE_THRESHOLD=100
# THUNAI_ANOMALY_RATIO_THRESHOLD=1.25
# Per-run harness caps (harness/hooks.py): spend cap in minor currency units,
# tool call-count cap, outbound-notification cap.
# THUNAI_SPEND_CAP_MINOR_UNITS=200
# THUNAI_TOOL_CALL_CAP=25
# THUNAI_NOTIFICATION_CAP=10

# -----------------------------------------------------------------------------
# Knowledge Base  (integrations/knowledge_provider.py, Req 8)
# Bedrock Knowledge Base (S3 Vectors) id — a stack output injected into the
# AgentCore runtime environment. Queried via the live bedrock-agent-runtime
# Retrieve API (the deprecated strands-agents-tools `retrieve` tool is NOT used).
# -----------------------------------------------------------------------------
THUNAI_KNOWLEDGE_BASE_ID=
# Bedrock Knowledge Base data source id backing the doc-source S3 bucket
# below — a stack output of the KnowledgeStack (task 21.3a). Read only by
# scripts/seed.sh (task 11.5) to call bedrock-agent.start_ingestion_job after
# uploading seed/knowledge_docs/ to THUNAI_KNOWLEDGE_DOCS_BUCKET.
THUNAI_KB_DATA_SOURCE_ID=
# S3 bucket the KnowledgeStack's Knowledge Base data source ingests from — a
# stack output. scripts/seed.sh uploads every seed/knowledge_docs/*.md file
# (excluding README.md) here before starting the ingestion job.
THUNAI_KNOWLEDGE_DOCS_BUCKET=

# -----------------------------------------------------------------------------
# Notifications  (integrations/notification_provider.py, surface/escalation_service.py, Req 7, 11)
# Verified SES sender identity for escalation emails. In a new account SES/SNS
# start in sandbox mode (verified recipients only) — sufficient for a demo to
# your own verified contacts.
# THUNAI_COORDINATOR_PHONE / THUNAI_COORDINATOR_EMAIL are the out-of-band
# destination Escalation_Service notifies on every new escalation (Req 11.2);
# leave either blank to skip that channel. While the account is in the
# SNS SMS / SES sandbox, the phone/email here must also be a verified
# destination (see integrations/notification_provider.py's verification note).
# -----------------------------------------------------------------------------
THUNAI_SES_SENDER=
THUNAI_COORDINATOR_PHONE=
THUNAI_COORDINATOR_EMAIL=

# -----------------------------------------------------------------------------
# DynamoDB tables  (memory/state_store.py, memory/audit_ledger.py, Req 15, 16)
# Set by the Data stack and injected into the runtime environment.
#   thunai-state  : incidents / requests / responders / shelters + idempotency
#   thunai-audit  : append-only audit ledger
#   thunai-memory : 30-day hazard baselines + coordinator preferences
# -----------------------------------------------------------------------------
THUNAI_STATE_TABLE=thunai-state
THUNAI_AUDIT_TABLE=thunai-audit
THUNAI_MEMORY_TABLE=thunai-memory

# -----------------------------------------------------------------------------
# AgentCore Memory  (memory/memory_store.py + Coordinator_Orchestrator session)
# AgentCore Memory resource id backing the coordinator's conversational memory.
# -----------------------------------------------------------------------------
THUNAI_MEMORY_ID=

# -----------------------------------------------------------------------------
# Authentication  (Auth stack / frontend — Cognito, Req 12.9, 12.10, 13.6)
# -----------------------------------------------------------------------------
THUNAI_COGNITO_USER_POOL_ID=
THUNAI_COGNITO_APP_CLIENT_ID=

# -----------------------------------------------------------------------------
# Real-time surface  (Realtime stack — AppSync Events, Req 11.2, 12.5, 14.x)
# stream_publisher_lambda.py publishes DynamoDB Stream changes to these channels.
# -----------------------------------------------------------------------------
THUNAI_EVENT_API_ID=
THUNAI_EVENT_API_HTTP_ENDPOINT=
THUNAI_EVENT_API_REALTIME_ENDPOINT=

# -----------------------------------------------------------------------------
# AgentCore Runtime / Gateway  (surface/entrypoint.py, surface/escalation_service.py)
# Runtime ARN is used by triggers/escalation to invoke_agent_runtime (resume).
# Gateway id/name back the live tool targets (e.g. the sensor-live target).
# -----------------------------------------------------------------------------
THUNAI_RUNTIME_ARN=
THUNAI_GATEWAY_ID=
THUNAI_GATEWAY_NAME=

# -----------------------------------------------------------------------------
# Observability and cost control  (harness/observability.py, Req 20)
# The currency unit cost figures are expressed in, and the per-1000-token input/
# output price of each of the two configured model tiers (Req 20.3). Prices are
# supplied by the deployer from the live Bedrock Nova price list — never baked
# in. Leave a price blank to price that tier at 0 (tokens/latency still counted).
# THUNAI_BUDGET_THRESHOLD_MINOR_UNITS is the per-billing-period spend threshold
# (in minor units, e.g. cents) at which the single in-run budget notification is
# delivered to THUNAI_COORDINATOR_EMAIL/PHONE (Req 20.5); it defaults to 2000
# ($20.00), matching the account-level AWS Budgets backstop in observability_stack.py.
# -----------------------------------------------------------------------------
THUNAI_COST_CURRENCY=USD
THUNAI_LOW_COST_INPUT_PRICE_PER_1K=
THUNAI_LOW_COST_OUTPUT_PRICE_PER_1K=
THUNAI_HIGH_CAPABILITY_INPUT_PRICE_PER_1K=
THUNAI_HIGH_CAPABILITY_OUTPUT_PRICE_PER_1K=
# THUNAI_BUDGET_THRESHOLD_MINOR_UNITS=2000

# -----------------------------------------------------------------------------
# Monitored river reach  (surface/entrypoint.py)
# The reach a sweep evaluates when the trigger payload names none. The incident
# id is derived from it (tools/incident_tools.py::incident_id_for_reach), so
# changing this starts tracking a different incident.
# -----------------------------------------------------------------------------
THUNAI_RIVER_REACH_ID=reach-7
